# ─── Server ───
PORT=5000
NODE_ENV=development

# ─── Database ───
# Local dev example:      mongodb://127.0.0.1:27017/novva-lms
# MongoDB Atlas example:  mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/novva-lms
MONGODB_URI=mongodb://127.0.0.1:27017/novva-lms

# ─── Auth ───
# Generate a strong secret: openssl rand -base64 48
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# ─── Bootstrap Admin (used only by scripts/seedAdmin.js) ───
ADMIN_NAME=Prof. Khizer Hayat
ADMIN_EMAIL=admin@ucp.edu.pk
ADMIN_PASSWORD=ChangeMe123!

# ─── Email (NodeMailer — any standard SMTP provider) ───
# Gmail example:  EMAIL_HOST=smtp.gmail.com        EMAIL_PORT=465 (implicit TLS)
# Brevo example:  EMAIL_HOST=smtp-relay.brevo.com  EMAIL_PORT=587 (STARTTLS)
# `secure` is derived automatically from the port (465 = implicit TLS, anything
# else = STARTTLS) — see backend/utils/sendEmail.js.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=your_smtp_login
EMAIL_PASS=your_smtp_password_or_key
# Must be a sender/domain verified with your SMTP provider, or delivery
# may silently land in spam or get rejected downstream.
EMAIL_FROM="Novva LMS <no-reply@novvalms.com>"

# ─── Frontend origin (for CORS) ───
CLIENT_URL=http://localhost:5173

# ─── AI provider (services/ai/) ───
# "gemini" or "openai" — switching is just this value + a restart, no code change.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ─── File Storage (used starting Sprint 3) ───
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_REGION=
